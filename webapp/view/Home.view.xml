<mvc:View
    controllerName="ui5basicspractice.project1.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    core:require="{formatter: 'ui5basicspractice/project1/model/formatter'}"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <l:VerticalLayout width="100%">
            <Button
                text="{i18n>messageBoxText}"
                class="sapUiSmallMarginBottom"
                press=".onInfoMessageBoxPress"
            />

            <f:SimpleForm
                id="SimpleCarForm"
                editable="true"
                layout="ResponsiveGridLayout"
                title="Cars"
                width="100%"
            >
                <f:content>
                    <Label
                        text="Car Name"
                        labelFor="carNameInput"
                    />
                    <Input
                        id="carNameInput"
                        placeholder="Enter car"
                        
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpRequest"
                        value="{manifestCarModel>/car}"
                    >
                    
                        
                    </Input>

                    <Label
                        text="Manufacturer Name"
                        labelFor="carManufacturerInput"
                    />
                    <Input
                        id="carManufacturerInput"
                        placeholder="Enter manufacturer"
                       
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpRequest"
                        value="{manifestCarModel>/manufacturer}"
                    >
                   
                    </Input>

                    <Label
                        text="DOM"
                        labelFor="carDOMInput"
                    />
                    <Input
                        id="carDOMInput"
                        placeholder="Enter DOM"
                        
                        value="{manifestCarModel>/DOM}"
                    >
                        
                    </Input>

                    <Label
                        text="Ownership"
                        labelFor="carOwnershipInput"
                    />
                    <Input
                        id="carOwnershipInput"
                        placeholder="Enter Ownership"
                       
                        showValueHelp="true"
                        valueHelpRequest=".onValueHelpRequest"
                        value="{manifestCarModel>/ownership}"
                    >
                        
                    </Input>

                    <Button
                        type="Success"
                        text="Submit"
                        press="onSubmitBtnPress"
                    />
                </f:content>
            </f:SimpleForm>

            <IconTabBar
                    id="idIconTabBarNoIcons"
                    expanded="{device>/isNoPhone}"
                    class="sapUiResponsiveContentPadding">
                    <items>
                        <IconTabFilter text="Table" key="table">
                            <Table
                                id="carTable"
                                inset="false"
                                items="{
                                path: 'manifestCarModel>/Cars',
                                sorter: {
                                    path: 'DOM'
                                }
                            }"
                            >
                                
                                <infoToolbar>
                                    <OverflowToolbar>
                                        <Label text="Cars available" />
                                    </OverflowToolbar>
                                    
                                </infoToolbar>
                                
                                <columns>
                                    <Column width="12em">
                                        <Text text="Car" />
                                    </Column>
                                    <Column>
                                        <Text text="Manufacturer" />
                                    </Column>
                                    <Column>
                                        <Text text="DOM" />
                                    </Column>
                                    <Column>
                                        <Text text="Ownership" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem vAlign="Middle">
                                        <cells>
                                            
                                            <Text text="{manifestCarModel>car}" />
                                            <Text
                                                text="{manifestCarModel>manufacturer}"
                                            />
                                            <Text text="{manifestCarModel>DOM}" />
                                            <Text
                                                text="{
                                                    path: 'manifestCarModel>ownership',
                                                    formatter: 'formatter.carOwnershipText'
                                                }"
                                            />
                                            
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </IconTabFilter>
                        <IconTabFilter text="List" key="list">
                            <List headerText="Custom Content" mode="Delete" items="{path: 'manifestCarModel>/Cars'}" >
                                <CustomListItem>
                                    <HBox>
                                        <core:Icon size="2rem" src="sap-icon://attachment-photo" class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom" />
                                        <VBox class="sapUiSmallMarginBegin sapUiSmallMarginTopBottom" >
                                            <Label text="{manifestCarModel>car}" />
                                            <Label text="{manifestCarModel>manufacturer}"/>
                                            <Label text="{manifestCarModel>DOM}"/>
                                            <Label text="{
                                                    path: 'manifestCarModel>ownership',
                                                    formatter: 'formatter.carOwnershipText'
                                                }"/>
                                        </VBox>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </IconTabFilter>
                    </items>
            </IconTabBar>
            
        </l:VerticalLayout>
    </Page>
</mvc:View>
