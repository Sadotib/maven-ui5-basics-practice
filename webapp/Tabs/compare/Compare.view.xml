<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    core:require="{formatter: 'ui5basicspractice/project1/model/formatter'}"
>

<Table
									id="carCompareTable"
									inset="false"
									items="{
										path: 'manifestCarModel>/Cars',
										sorter: {
											path: 'DOM'
										}
									}">
									<columns>
										<Column width="12em">
											<Text text="Car" />
										</Column>

										<Column>
											<Text text="Manufacturer" />
										</Column>
										<Column>
											<Text text="Date of Manufacture" />
										</Column>
										<Column>
											<Text text="Cylinders" />
										</Column>
										<Column>
											<Text text="Power" />
										</Column>
										<Column>
											<Text text="Size" />
										</Column>
									</columns>
									<items>
										<ColumnListItem vAlign="Middle">
											<cells>
												<Text text="{manifestCarModel>car}" />
												<Text text="{manifestCarModel>manufacturer}" />
												<Text text="{manifestCarModel>DOM}" />
												
												<Text
													text="{
														path: 'manifestCarModel>ownership',
														formatter: 'formatter.carOwnershipText'
														}"
												/>
												<Text text="{manifestCarModel>Engine/0/cylinder}" />
												<Text text="{manifestCarModel>Engine/0/power}" />
												<Text text="{manifestCarModel>Dimension/0/size}" />
											</cells>
										</ColumnListItem>
									</items>
								</Table>
</mvc:View>