<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    core:require="{formatter: 'ui5basicspractice/project1/model/formatter'}"
>
<VBox>
                                        <Label text="Dimension" class="sapUiSmallMarginBottom"/>
                                        <Table 
                                            items="{manifestCarModel>Dimension}"
                                            class="sapUiResponsiveMargin"
                                            width="auto">
                                            <columns>
                                                <Column>
                                                    <Text text="Size"/>
                                                </Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text 
                                                            text="{
															path: 'manifestCarModel>size',
															formatter: 'formatter.carSizeText'}"
                                                            />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </VBox>

</mvc:View>