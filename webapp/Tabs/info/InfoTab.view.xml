
<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    core:require="{formatter: 'ui5basicspractice/project1/model/formatter'}">
    <Table
									id="carInfoTable"
									inset="false"
									>
									<columns>
										<Column width="12em">
											<Text text="Car" />
										</Column>

										<Column>
											<Text text="Manufacturerrr" />
										</Column>
										<Column>
											<Text text="Date of Manufacture" />
										</Column>
									</columns>
									<items>
										<ColumnListItem vAlign="Middle">
											<cells>
												<Text text="{testManifestCarModel>car}" />
												<Text text="{testManifestCarModel>manufacturer}" />
												<Text text="{testManifestCarModel>DOM}" />
												<Text
													text="{
														path: 'maniftestManifestCarModelestCarModel>ownership',
														formatter: 'formatter.carOwnershipText'
														}"
												/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>

                                </mvc:View>
