<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    core:require="{formatter: 'ui5basicspractice/project1/model/formatter'}"
>
<VBox>
                                        <Label text="Engine Specificationssss" class="sapUiSmallMarginBottom"/>
                                        <Table 
                                            items="{manifestCarModel>Engine}"
                                            class="sapUiResponsiveMargin"
                                            width="auto">
                                            <columns>
                                                <Column width="12em">
                                                    <Text text="Cylinders"/>
                                                </Column>
                                                <Column>
                                                    <Text text="Power"/>
                                                </Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem vAlign="Middle">
                                                    <cells>
                                                        <Text text="{manifestCarModel>cylinder}" />
                                                        <Text text="{manifestCarModel>power}"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </VBox>

</mvc:View>